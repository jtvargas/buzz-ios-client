<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same container the app writes its snapshot into; a mismatch here is a widget
	     that reads nothing and can only ever draw "Open Hive to set up". -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jtvargas.hive</string>
	</array>
	<!-- The shared group holding the copy of the identity key this extension signs its
	     NIP-98 request with. It never writes a key and never reads any other group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.jtvargas.hive.shared</string>
	</array>
</dict>
</plist>

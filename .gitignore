# Xcode project is generated from project.yml by XcodeGen
*.xcodeproj

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
# CI passes -derivedDataPath .dd so the cache has a stable path; running the
# same command locally puts ~900 MB here. The glob covers the per-destination
# spellings too (.dd-sim, .dd-device) — one `git add -A` with only `.dd/`
# ignored stages ten thousand build artifacts, which is a very quiet mistake.
.dd*/
build/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Personal signing config (never commit team IDs / bundle overrides)
Config/Local.xcconfig

# Provisioning artifacts
*.mobileprovision
*.provisionprofile
*.certSigningRequest
*.p12

# SPM (dependency versions are pinned .exact in Package.swift)
.build/
.swiftpm/
Package.resolved
# …except the one Xcode Cloud requires. It builds with automatic package
# resolution disabled machine-wide, so it cannot produce this file and neither
# can `ci_post_clone.sh` — it can only be handed one. Kept here and copied into
# the generated project by that script. `make pins` refreshes it.
!Config/Package.resolved

# macOS
.DS_Store

# Tooling
*.log
.env

# What a failing render test leaves behind to be looked at, never committed.
App/Tests/Snapshots/*.actual.png

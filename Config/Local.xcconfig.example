// Copy this file to Config/Local.xcconfig (gitignored) to build under an Apple
// ID other than the owner's.
//
// The owner's team and bundle id live in Shared.xcconfig, so device builds and
// Xcode Cloud sign without this file. It exists for a second developer, whose
// Apple ID cannot sign for that team.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = com.yourdomain.hive
